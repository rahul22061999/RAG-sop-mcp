HF_TOKEN=
GEMINI_API_KEY=
LLAMA_PARSE=

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Postgres (pgvector). PG_SSL_MODE=disable for the local Docker container
# (docker-compose.yml), PG_SSL_MODE=require for Cloud SQL/AlloyDB/managed.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=wmsusr
PG_PASSWORD=
PG_TABLE_NAME=sop_chunks
PG_SCHEMA_NAME=public
PG_SSL_MODE=disable

# Ollama endpoint used for answer generation. host.docker.internal is
# correct for Docker Desktop on Mac/Windows only - override for Linux
# hosts or a real deployment target.
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_REQUEST_TIMEOUT=60.0

UNKEY_ROOT_API_KEY=
